```{r}
# Calculate league averages
league_wOBA <- platoon_data %>%
  group_by(year) %>%
  summarize(league_avg_wOBA = weighted.mean((wOBA_vs_LHP * PA_vs_LHP + wOBA_vs_RHP * PA_vs_RHP) / (PA_vs_LHP + PA_vs_RHP), 
                                             PA_vs_LHP + PA_vs_RHP, na.rm = TRUE))

wOBA_scale <- 1.20

# Create modeling dataset - FILTER FOR EXTREME/STRONG ONLY
model_data <- platoon_data %>%
  left_join(league_wOBA, by = "year") %>%
  mutate(
    platoon_advantage = abs(wOBA_vs_LHP - wOBA_vs_RHP),
    
    # Classify platoon severity
    platoon_category = case_when(
      platoon_advantage >= 0.070 ~ "Extreme",
      platoon_advantage >= 0.040 ~ "Strong",
      platoon_advantage >= 0.020 ~ "Moderate",
      TRUE ~ "Minimal"
    ),
    
    # Optimal PA distribution
    optimal_pct_good = case_when(
      platoon_advantage >= 0.070 ~ 0.70,
      platoon_advantage >= 0.040 ~ 0.60,
      TRUE ~ 0.50
    ),
    
    # Calculate optimal wOBA and wRAA
    wOBA_good = pmax(wOBA_vs_LHP, wOBA_vs_RHP),
    wOBA_bad = pmin(wOBA_vs_LHP, wOBA_vs_RHP),
    total_PA = PA_vs_LHP + PA_vs_RHP,
    
    optimal_wOBA = (wOBA_good * optimal_pct_good + wOBA_bad * (1 - optimal_pct_good)),
    optimal_wRAA = ((optimal_wOBA - league_avg_wOBA) / wOBA_scale) * total_PA
  ) %>%
  # *** KEY FILTER: Only Extreme or Strong platoon players ***
  filter(
    platoon_category %in% c("Extreme", "Strong"),
    !is.na(optimal_wRAA), 
    total_PA >= 200
  )

# Check how many players qualify
model_data %>%
  count(year, platoon_category)
