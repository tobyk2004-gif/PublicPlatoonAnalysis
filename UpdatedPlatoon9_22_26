```{r}
xgb_leaderboard_2025 <- test_wOBA %>%
  mutate(
    # Predicted split size
    predicted_split = predicted_wOBA_vs_LHP - predicted_wOBA_vs_RHP,
    predicted_split_size = abs(predicted_split),
    
    # Classify platoon severity based on PREDICTED splits
    platoon_category = case_when(
      predicted_split_size >= 0.070 ~ "Extreme",
      predicted_split_size >= 0.040 ~ "Strong",
      predicted_split_size >= 0.020 ~ "Moderate",
      TRUE ~ "Minimal"
    ),
    
    # Optimal PA distribution
    optimal_pct_good = case_when(
      platoon_category == "Extreme" ~ 0.70,
      platoon_category == "Strong" ~ 0.60,
      TRUE ~ 0.50
    ),
    
    # PA reduction from platooning
    platoon_PA_reduction = case_when(
      platoon_category == "Extreme" ~ 0.70,
      platoon_category == "Strong" ~ 0.80,
      TRUE ~ 1.00
    ),
    
    # Total PA from actual 2025
    #total_PA = PA_vs_LHP + PA_vs_RHP,
    
    # Actual wOBA (from real 2025 data)
    actual_wOBA_2025 = (wOBA_vs_LHP * PA_vs_LHP + wOBA_vs_RHP * PA_vs_RHP) / total_PA,
    
    # Platooned total PA (reduced)
    platoon_total_PA = total_PA * platoon_PA_reduction,
    
    # Identify good/bad matchup from PREDICTED splits
    wOBA_good = pmax(predicted_wOBA_vs_LHP, predicted_wOBA_vs_RHP),
    wOBA_bad = pmin(predicted_wOBA_vs_LHP, predicted_wOBA_vs_RHP),
    
    # Optimal PA distribution
    platoon_PA_good = platoon_total_PA * optimal_pct_good,
    platoon_PA_bad = platoon_total_PA * (1 - optimal_pct_good),
    
    # Actual PA in good matchup (from real 2025 usage)
    actual_PA_good = ifelse(predicted_split > 0, PA_vs_LHP, PA_vs_RHP),
    actual_PA_bad = ifelse(predicted_split > 0, PA_vs_RHP, PA_vs_LHP),
    
    # Platoon wOBA using predicted splits
    platoon_total_wOBA = (wOBA_good * platoon_PA_good + wOBA_bad * platoon_PA_bad) / platoon_total_PA,
    
    # wOBA gain
    wOBA_gain = platoon_total_wOBA - actual_wOBA_2025
  ) %>%
  filter(
    platoon_category %in% c("Extreme", "Strong"),
    wOBA_gain > 0
  ) %>%
  transmute(
    Rank = row_number(),
    Player = player_name,
    Team = team_name,
    Category = platoon_category,
    `Platoon wOBA Gain` = round(wOBA_gain, 3),
    `2025 wOBA` = round(actual_wOBA_2025, 3),
    `Platoon Total wOBA` = round(platoon_total_wOBA, 3),
    `Pred wOBA Split (LHP-RHP)` = round(predicted_split, 3),
    `2025 PA` = round(total_PA, 0),
    `Actual PA vs LHP` = round(PA_vs_LHP, 0),
    `Actual PA vs RHP` = round(PA_vs_RHP, 0),
    `Platoon Total PA` = round(platoon_total_PA, 0),
    `Platoon PA LHP` = round(ifelse(predicted_split > 0, platoon_PA_good, platoon_PA_bad), 0),
    `Platoon PA RHP` = round(ifelse(predicted_split > 0, platoon_PA_bad, platoon_PA_good), 0)
  ) %>%
  arrange(desc(`Platoon wOBA Gain`))

