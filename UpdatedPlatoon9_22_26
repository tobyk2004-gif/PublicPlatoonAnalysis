platoon_category = case_when(
  actual_split_size >= 0.070 ~ "Extreme",
  actual_split_size >= 0.040 ~ "Strong",
  actual_split_size >= 0.020 ~ "Moderate",
  TRUE ~ "Minimal"
),
    
    optimal_pct_good = case_when(
      platoon_category == "Extreme" ~ 0.70,
      platoon_category == "Strong" ~ 0.60,
      TRUE ~ 0.50
    ),
    
    platoon_PA_reduction = case_when(
      platoon_category == "Extreme" ~ 0.70,
      platoon_category == "Strong" ~ 0.80,
      TRUE ~ 1.00
    ),
    
    # 2025 actual usage as baseline for 2026
total_PA_2025 = PA_vs_LHP + PA_vs_RHP,
pct_PA_vs_LHP_2025 = PA_vs_LHP / total_PA_2025,
pct_PA_vs_RHP_2025 = PA_vs_RHP / total_PA_2025,
projected_total_PA_2026 = total_PA_2025,

# Use actual 2025 split to determine good/bad matchup
actual_split = wOBA_vs_LHP - wOBA_vs_RHP,
actual_split_size = abs(actual_split),

# Suboptimal (same deployment as 2025)
sub_PA_vs_LHP = projected_total_PA_2026 * pct_PA_vs_LHP_2025,
sub_PA_vs_RHP = projected_total_PA_2026 * pct_PA_vs_RHP_2025,
wOBA_good = pmax(predicted_2026_wOBA_vs_LHP, predicted_2026_wOBA_vs_RHP),
wOBA_bad = pmin(predicted_2026_wOBA_vs_LHP, predicted_2026_wOBA_vs_RHP),
sub_PA_good = ifelse(actual_split > 0, sub_PA_vs_LHP, sub_PA_vs_RHP),
sub_PA_bad = ifelse(actual_split > 0, sub_PA_vs_RHP, sub_PA_vs_LHP),
sub_wOBA = (wOBA_good * sub_PA_good + wOBA_bad * sub_PA_bad) / projected_total_PA_2026,

# Platooned scenario
plat_total_PA = projected_total_PA_2026 * platoon_PA_reduction,
plat_PA_good = plat_total_PA * optimal_pct_good,
plat_PA_bad = plat_total_PA * (1 - optimal_pct_good),
plat_wOBA = (wOBA_good * plat_PA_good + wOBA_bad * plat_PA_bad) / plat_total_PA,

wOBA_gain = plat_wOBA - sub_wOBA

  ) %>%
