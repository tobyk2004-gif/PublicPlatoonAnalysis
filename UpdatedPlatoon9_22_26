```{r}
# First, calculate league average wOBA for each year
league_wOBA <- platoon_analysis %>%
  group_by(year) %>%
  summarize(
    league_avg_wOBA = weighted.mean(overall_wOBA, total_PA, na.rm = TRUE)
  )

# wOBA scale factor (typically 1.15-1.25, varies by year)

wOBA_scales <- data.frame(
  year = 2021:2025,
  wOBA_scale = c(1.253, 1.181, 1.206, 1.214, 1.220)  # Approximate values
)

value_calculation <- platoon_analysis %>%
  filter(year == 2025) %>%
  left_join(league_wOBA, by = "year") %>%
  left_join(wOBA_scales, by = "year") %>%
  
  mutate(
    # Calculate "optimal" PA distribution
    optimal_PA_good = case_when(
      platoon_category == "Extreme" ~ total_PA * 0.70,
      platoon_category == "Strong" ~ total_PA * 0.60,
      TRUE ~ total_PA * 0.50
    ),
    
    optimal_PA_bad = total_PA - optimal_PA_good,
    
    # Actual PA in good vs bad matchup
    actual_PA_good = ifelse(wOBA_diff > 0, PA_vs_LHP, PA_vs_RHP),
    actual_PA_bad = ifelse(wOBA_diff > 0, PA_vs_RHP, PA_vs_LHP),
    
    # wOBA in good vs bad matchup
    wOBA_good = ifelse(wOBA_diff > 0, wOBA_vs_LHP, wOBA_vs_RHP),
    wOBA_bad = ifelse(wOBA_diff > 0, wOBA_vs_RHP, wOBA_vs_LHP),
    
    # Expected wOBA under optimal deployment
    expected_wOBA_optimal = (wOBA_good * optimal_PA_good + wOBA_bad * optimal_PA_bad) / total_PA,
    
    # Actual wOBA (already calculated)
    actual_wOBA = overall_wOBA,
    
    # Calculate wRAA for actual usage
    wRAA_actual = ((actual_wOBA - league_avg_wOBA) / wOBA_scale) * total_PA,
    
    # Calculate wRAA for optimal usage
    wRAA_optimal = ((expected_wOBA_optimal - league_avg_wOBA) / wOBA_scale) * total_PA,
    
    # Platoon Value Added = difference in runs
    platoon_runs_added = wRAA_optimal - wRAA_actual,
    
    # Convert to wins (10 runs ≈ 1 win)
    platoon_wins_added = platoon_runs_added / 10
  )

total_value_lost <- value_calculation %>%
  filter(platoon_runs_added > 0) %>%
  summarize(
    total_players = n(),
    total_runs = sum(platoon_runs_added),
    total_wins = sum(platoon_runs_added) / 10,
    avg_runs_per_player = mean(platoon_runs_added)
  )

print(total_value_lost)
