```{r}
# Create dataset for predicting wOBA
wOBA_model_data <- platoon_data %>%
  arrange(player_id, year) %>%
  group_by(player_id) %>%
  mutate(
   prior_wOBA_vs_LHP = lag(wOBA_vs_LHP, 1),
    prior_wOBA_vs_RHP = lag(wOBA_vs_RHP, 1),
   
    # Total PA across two years for threshold
    total_PA_2yr_LHP = lag(PA_vs_LHP, 1) + lag(PA_vs_LHP, 2),
    total_PA_2yr_RHP = lag(PA_vs_RHP, 1) + lag(PA_vs_RHP, 2),
    
    # 2-year averages wOBA (no leakage)
    avg_2yr_wOBA_LHP = (lag(wOBA_vs_LHP, 1) + lag(wOBA_vs_LHP, 2)) / 2,
    avg_2yr_wOBA_RHP = (lag(wOBA_vs_RHP, 1) + lag(wOBA_vs_RHP, 2)) / 2,
    
    # K% prior years
   avg_2yr_K_pct_LHP = (lag(K_pct_vs_LHP, 1) + lag(K_pct_vs_LHP, 2)) / 2,
    avg_2yr_K_pct_RHP = (lag(K_pct_vs_RHP, 1) + lag(K_pct_vs_RHP, 2)) / 2,
    
    # BB% prior years
avg_2yr_BB_pct_LHP = (lag(BB_pct_vs_LHP, 1) + lag(BB_pct_vs_LHP, 2)) / 2,
    avg_2yr_BB_pct_RHP = (lag(BB_pct_vs_RHP, 1) + lag(BB_pct_vs_RHP, 2)) / 2,

    # BABIP prior years
    #prior_BABIP_vs_LHP = lag(BABIP_vs_LHP, 1),
    #prior_BABIP_vs_RHP = lag(BABIP_vs_RHP, 1),
    avg_2yr_BABIP_LHP = (lag(BABIP_vs_LHP, 1) + lag(BABIP_vs_LHP, 2)) / 2,
    avg_2yr_BABIP_RHP = (lag(BABIP_vs_RHP, 1) + lag(BABIP_vs_RHP, 2)) / 2,
    
  #LHP Stuff to boost R2
    prior_K_pct_vs_LHP = lag(K_pct_vs_LHP, 1),
    prior_BB_pct_vs_LHP = lag(BB_pct_vs_LHP, 1),
    prior_BABIP_vs_LHP = lag(BABIP_vs_LHP, 1),
    
    # Overall performance
    overall_wOBA = (wOBA_vs_LHP * PA_vs_LHP + wOBA_vs_RHP * PA_vs_RHP) / (PA_vs_LHP + PA_vs_RHP),
    prior_overall_wOBA = lag(overall_wOBA, 1)
  ) %>%
  ungroup() %>%
  filter(!is.na(prior_wOBA_vs_LHP))

