```{r}
# Add calculated metrics
platoon_analysis <- platoon_data %>%
  mutate(
    # Platoon advantage magnitude
    platoon_advantage = abs(wOBA_diff),
    
    # Which side they hit better
    better_vs = ifelse(wOBA_diff > 0, "LHP", "RHP"),
    
    # Overall wOBA (weighted by PA)
    overall_wOBA = (wOBA_vs_LHP * PA_vs_LHP + wOBA_vs_RHP * PA_vs_RHP) / total_PA,
    
    # Platoon usage ratio (0-1, where 0.5 = perfectly balanced)
    platoon_usage_LHP = PA_vs_LHP / total_PA,
    platoon_usage_RHP = PA_vs_RHP / total_PA,
    
    # Classify platoon severity
    platoon_category = case_when(
      platoon_advantage >= 0.070 ~ "Extreme",
      platoon_advantage >= 0.040 ~ "Strong",
      platoon_advantage >= 0.020 ~ "Moderate",
      TRUE ~ "Minimal"
    ),
    
    # Identify if they're being used "optimally"
    # Heuristic: if you're much better vs LHP, you should face LHP more
    optimal_usage = case_when(
      wOBA_diff > 0.040 & platoon_usage_LHP < 0.30 ~ "Underused_vs_LHP",
      wOBA_diff < -0.040 & platoon_usage_RHP < 0.30 ~ "Underused_vs_RHP",
      platoon_advantage < 0.030 ~ "No_platoon_needed",
      TRUE ~ "Reasonable"
    )
  )
# Summary statistics
platoon_analysis %>%
  group_by(year, platoon_category) %>%
  summarize(
    n_players = n(),
    avg_advantage = mean(platoon_advantage),
    .groups = "drop"
  )
